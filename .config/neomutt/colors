# ----------------------------------------------------
# NY Taxi (Medallion Dark) Theme for NeoMutt
# ----------------------------------------------------

# Basic Interface
color normal        color254 default
color error         color203 default
color tilde         color240 default
color message       color220 default
color attachment    color220 default
color search        color220 color236
color status        color254 color235
color indicator     color234 color220  # The email selection cursor (black on taxi yellow)
color progress      color234 color220

# Sidebar
color sidebar_divider    color238 default
color sidebar_flagged    color203 default
color sidebar_new        color220 default
color sidebar_highlight  color220 default  # The sidebar cursor (hover)
color sidebar_indicator  color234 color220 # The CURRENTLY OPEN mailbox

# Index List (The list of emails)
color index         color254 default '.*'
color index_author  color248 default '.*'
color index_subject color254 default '.*'
color index_number  color240 default

# Unread emails
color index         color220 default "~N"
color index_author  color220 default "~N"
color index_subject color220 default "~N"

# Email Header View
color hdrdefault    color240 default
color header        color220 default "^(From)"
color header        color220 default "^(Subject)"
color header        color248 default "^(CC|BCC|To)"

# Email Body View
color quoted        color114 default
color quoted1       color248 default
color quoted2       color240 default
color signature     color240 default

# Regex Highlights in Body
color body          color220 default "[\-\.+_a-zA-Z0-9]+@[\-\.a-zA-Z0-9]+" # Emails
color body          color220 default "(https?|ftp)://[\-\.,/%~_:?&=\#a-zA-Z0-9]+" # URLs
