#!/usr/bin/env python3
"""
Interactive Google Calendar Invite & Cancellation Handler for NeoMutt
- Reads an email with an .ics invite/cancellation from standard input.
- Displays event details in a clean banner.
- Reads a single keypress [a/t/d/i/o/q] or [r/o/q] without requiring Enter.
- As soon as a key is pressed:
    - If [q]: instantly returns to NeoMutt (0ms delay).
    - If [a/t/d/i/r]: instantly spawns a detached background worker and returns
      to NeoMutt immediately so the user can navigate to the next email.
    - The background worker executes khal import/update/delete, sends RFC 5546
      RSVP emails via smart_sendmail.py, synchronizes via vdirsyncer, and notifies
      the user in the tmux center status display.
"""

import sys
import os
import re
import email
from email.message import EmailMessage
import tempfile
import subprocess
import datetime
import urllib.parse
import icalendar

LOG_FILE = os.path.expanduser("~/.config/neomutt/schedule.log")
CALENDARS_DIR = os.path.expanduser("~/.local/share/calendars")
TARGET_CAL = "personal"
CAL_LABEL = "Google Calendar"

def log(msg):
    timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{timestamp}] [ics-to-khal] {msg}\n"
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(line)
    except Exception:
        pass

def notify(title, msg):
    # In-tmux status bar notification (center display, cross-platform Linux & macOS)
    try:
        text = f"{title}: {msg}"
        subprocess.run(["tmux", "set", "-g", "@notification", text], capture_output=True, check=False)
        subprocess.run(["tmux", "refresh-client", "-S"], capture_output=True, check=False)
        subprocess.run(["tmux", "run-shell", "-b", "sleep 5 && tmux set -gu @notification && tmux refresh-client -S"], capture_output=True, check=False)
    except Exception:
        pass

def open_url(url):
    cmd = 'open' if sys.platform == 'darwin' else 'xdg-open'
    try:
        subprocess.Popen([cmd, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        log(f"Failed to open URL {url}: {e}")

def trigger_vdirsyncer_sync():
    """Trigger background Google Calendar sync. Detached so NeoMutt never hangs."""
    try:
        subprocess.Popen(
            ["vdirsyncer", "sync", "personal_calendar"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )
        log("Triggered background vdirsyncer sync for Google Calendar")
    except Exception as e:
        log(f"Failed to trigger vdirsyncer sync: {e}")

def sanitize_header(val):
    """Strip newlines, linefeeds, and tabs to prevent email header injection/ValueErrors."""
    if not val:
        return ""
    return re.sub(r'[\r\n\t]+', ' ', str(val)).strip()

def format_cal_datetime(dt_val):
    if dt_val is None:
        return "N/A"
    dt = dt_val.dt if hasattr(dt_val, 'dt') else dt_val
    if isinstance(dt, datetime.datetime):
        tz_name = dt.strftime("%Z").strip()
        tz_str = f" {tz_name}" if tz_name else ""
        return dt.strftime("%A, %d %B %Y at %H:%M") + tz_str
    elif isinstance(dt, datetime.date):
        return dt.strftime("%A, %d %B %Y (All day)")
    return str(dt)

def clean_email(addr_str):
    if not addr_str:
        return ""
    addr = re.sub(r'(?i)^mailto:', '', str(addr_str).strip())
    m = re.search(r'<([^>]+)>', addr)
    if m:
        return m.group(1).strip()
    return addr.strip()

def extract_ics(raw_bytes, msg=None):
    if msg is None:
        msg = email.message_from_bytes(raw_bytes)
    ics_content = None
    part_method = None
    for part in msg.walk():
        c_type = part.get_content_type()
        f_name = part.get_filename() or ""
        if c_type in ['text/calendar', 'application/ics'] or f_name.lower().endswith('.ics'):
            payload = part.get_payload(decode=True)
            if payload:
                ics_content = payload
                part_method = part.get_param('method')
                break

    if not ics_content and b"BEGIN:VCALENDAR" in raw_bytes:
        start_idx = raw_bytes.find(b"BEGIN:VCALENDAR")
        end_idx = raw_bytes.find(b"END:VCALENDAR")
        if start_idx != -1 and end_idx != -1:
            ics_content = raw_bytes[start_idx:end_idx + len(b"END:VCALENDAR")]
    return ics_content, part_method

def find_events_by_uid(uid):
    """Search local calendar storage for .ics files containing UID:<uid>."""
    if not uid:
        return []
    clean_uid = uid.strip()
    results = []
    if not os.path.isdir(CALENDARS_DIR):
        return results

    for root, dirs, files in os.walk(CALENDARS_DIR):
        for fname in files:
            if not fname.endswith(".ics"):
                continue
            fpath = os.path.join(root, fname)
            try:
                with open(fpath, "r", encoding="utf-8", errors="ignore") as f:
                    content = f.read()
                found = False
                if clean_uid in content:
                    found = True
                else:
                    unfolded = re.sub(r'\r?\n[ \t]', '', content)
                    if f"UID:{clean_uid}" in unfolded:
                        found = True
                if found:
                    m = re.search(r'(?i)^SUMMARY:(.*)$', content, re.MULTILINE)
                    ev_sum = m.group(1).strip() if m else fname
                    results.append((fpath, ev_sum))
            except Exception:
                continue
    return results

def detect_user_email(msg, event=None):
    """Detect whether user was invited via work email or gmail to ensure RSVP reply matches."""
    headers_to_check = ['To', 'Delivered-To', 'Cc', 'X-Original-To', 'Envelope-To']
    combined_recipients = " ".join(str(msg.get(h, '')).lower() for h in headers_to_check)
    if "sciencespobordeaux.fr" in combined_recipients or "scpobx.fr" in combined_recipients:
        return "m.temporao@sciencespobordeaux.fr"

    if event:
        attendees = event.get('attendee')
        if attendees:
            if not isinstance(attendees, list):
                attendees = [attendees]
            for att in attendees:
                att_str = str(att).lower()
                if "sciencespobordeaux.fr" in att_str or "scpobx.fr" in att_str:
                    return "m.temporao@sciencespobordeaux.fr"

    return "mickael.temporao@gmail.com"

def remove_event_file(fpath, summary=""):
    try:
        if os.path.exists(fpath):
            os.remove(fpath)
            log(f"Removed event '{summary}' ({fpath}).")
            return True
    except Exception as e:
        log(f"Failed to remove file '{fpath}': {e}")
    return False

def get_single_key(tty_in):
    """Read a single keypress without waiting for Enter."""
    try:
        import tty
        import termios
        fd = tty_in.fileno()
        old_settings = termios.tcgetattr(fd)
        try:
            tty.setcbreak(fd)
            ch = tty_in.read(1)
            if ch in ['\r', '\n']:
                return '\n'
            if ch in ['\x03', '\x04', '\x1b']:
                return 'q'
            return ch.lower()
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
    except Exception:
        line = tty_in.readline()
        return line.strip().lower()[:1] if line else 'q'

def run_worker(choice, user_email, tmp_eml_path):
    """Background worker process executing import/RSVP/sync asynchronously."""
    try:
        with open(tmp_eml_path, "rb") as f:
            raw_email = f.read()
    except Exception as e:
        log(f"Worker failed to read temp email '{tmp_eml_path}': {e}")
        return

    try:
        msg = email.message_from_bytes(raw_email)
        ics_content, _ = extract_ics(raw_email, msg)
        if not ics_content:
            log("Worker: No ics content found")
            return

        cal = icalendar.Calendar.from_ical(ics_content)
        event = None
        for comp in cal.walk('VEVENT'):
            event = comp
            break
        if not event:
            log("Worker: No VEVENT found")
            return

        summary = sanitize_header(str(event.get('summary', 'No Title')))
        uid = str(event.get('uid', '')).strip()
        dtstart = event.get('dtstart')
        dtend = event.get('dtend')
        organizer_raw = str(event.get('organizer', ''))
        organizer = clean_email(organizer_raw)
        organizer_name = ''
        if event.get('organizer') and hasattr(event.get('organizer'), 'params'):
            organizer_name = sanitize_header(str(event.get('organizer').params.get('cn', '')))

        user_name = "Mickael Temporão"

        # 1. Action: Remove / Cancel / Decline
        if choice in ['r', 'd']:
            existing = find_events_by_uid(uid)
            for fpath, ev_sum in existing:
                remove_event_file(fpath, ev_sum)
            trigger_vdirsyncer_sync()
            if choice == 'r':
                log(f"Worker: Removed cancelled event '{summary}' (UID: {uid})")
                notify("NeoMutt Calendar", f" Cancelled event removed: {summary}")

        # 2. Action: Import / Update
        if choice in ['a', 't', 'i']:
            with tempfile.NamedTemporaryFile(suffix='.ics', delete=False) as f:
                f.write(ics_content)
                ics_path = f.name
            try:
                res = subprocess.run(
                    ['khal', 'import', '--batch', '-a', TARGET_CAL, ics_path],
                    capture_output=True,
                    text=True
                )
                if res.returncode == 0:
                    log(f"Worker: Successfully imported/updated '{summary}' (UID: {uid}) in '{TARGET_CAL}'")
                    trigger_vdirsyncer_sync()
                else:
                    err_msg = res.stderr.strip() or res.stdout.strip()
                    log(f"Worker: khal import warning/error for '{summary}': {err_msg}")
                    trigger_vdirsyncer_sync()
            finally:
                if os.path.exists(ics_path):
                    os.remove(ics_path)

        # 3. Action: Send Reply Email
        partstat = None
        if choice == 'a':
            partstat = "ACCEPTED"
        elif choice == 't':
            partstat = "TENTATIVE"
        elif choice == 'd':
            partstat = "DECLINED"

        if partstat and organizer:
            reply_cal = icalendar.Calendar()
            reply_cal.add('prodid', '-//NeoMutt Calendar Responder//EN')
            reply_cal.add('version', '2.0')
            reply_cal.add('method', 'REPLY')

            reply_event = icalendar.Event()
            if uid:
                reply_event.add('uid', uid)
            reply_event.add('summary', summary)
            if dtstart:
                reply_event.add('dtstart', dtstart.dt if hasattr(dtstart, 'dt') else dtstart)
            if dtend:
                reply_event.add('dtend', dtend.dt if hasattr(dtend, 'dt') else dtend)
            reply_event.add('organizer', icalendar.vCalAddress(f"mailto:{organizer}"))

            attendee = icalendar.vCalAddress(f"mailto:{user_email}")
            attendee.params['partstat'] = icalendar.vText(partstat)
            attendee.params['cn'] = icalendar.vText(user_name)
            attendee.params['role'] = icalendar.vText('REQ-PARTICIPANT')
            reply_event.add('attendee', attendee)

            reply_event.add('dtstamp', datetime.datetime.now(datetime.timezone.utc))
            reply_cal.add_component(reply_event)

            ics_reply_bytes = reply_cal.to_ical()

            reply_msg = EmailMessage()
            subject_status = "Accepted" if partstat == "ACCEPTED" else ("Tentative" if partstat == "TENTATIVE" else "Declined")
            orig_subj = sanitize_header(msg.get('Subject', ''))
            clean_subj = sanitize_header(re.sub(r'(?i)^(re:\s*)+', '', orig_subj))
            subj_line = sanitize_header(f"{subject_status}: {clean_subj or summary}")
            reply_msg['Subject'] = subj_line
            reply_msg['From'] = f"{user_name} <{user_email}>"
            reply_msg['To'] = f"{organizer_name} <{organizer}>" if organizer_name else organizer

            orig_msg_id = sanitize_header(msg.get('Message-ID', ''))
            if orig_msg_id:
                reply_msg['In-Reply-To'] = orig_msg_id
                reply_msg['References'] = orig_msg_id

            body_text = f"{user_name} has {subject_status.lower()}: {summary}\n\nWhen: {format_cal_datetime(dtstart)}\n"
            reply_msg.set_content(body_text)

            reply_msg.add_attachment(
                ics_reply_bytes,
                maintype='text',
                subtype='calendar',
                filename='invite.ics',
                params={'method': 'REPLY', 'charset': 'UTF-8'}
            )

            raw_reply_bytes = reply_msg.as_bytes()

            sendmail_script = os.path.expanduser("~/.config/neomutt/smart_sendmail.py")
            env = os.environ.copy()
            env["PASSWORD_STORE_DIR"] = os.environ.get("PASSWORD_STORE_DIR", os.path.expanduser("~/.config/passwords"))
            env["PATH"] = f"/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:{env.get('PATH', '')}"

            proc = subprocess.Popen(
                [sys.executable, sendmail_script],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=env
            )
            _, stderr = proc.communicate(input=raw_reply_bytes)

            if proc.returncode == 0:
                log(f"Worker: Response {partstat} for '{summary}' sent to {organizer}")
                icon = "" if partstat in ["ACCEPTED", "TENTATIVE"] else ""
                notify("NeoMutt Calendar", f"{icon} Event {partstat.lower()} & synced: {summary}")
            else:
                err_msg = stderr.decode('utf-8', errors='ignore').strip()
                log(f"Worker: Failed to send {partstat} to {organizer}: {err_msg}")
                notify("NeoMutt Calendar ERROR", f"Failed to send RSVP to {organizer}: {err_msg}")
        elif choice == 'i':
            notify("NeoMutt Calendar", f" Event imported & synced: {summary}")

    except Exception as e:
        log(f"Worker unhandled exception: {e}")
        notify("NeoMutt Calendar ERROR", f"Calendar error: {e}")
    finally:
        if os.path.exists(tmp_eml_path):
            try:
                os.remove(tmp_eml_path)
            except Exception:
                pass

def main():
    # Handle background worker invocation
    if len(sys.argv) > 4 and sys.argv[1] == "--worker":
        choice = sys.argv[2]
        user_email = sys.argv[3]
        tmp_eml_path = sys.argv[4]
        run_worker(choice, user_email, tmp_eml_path)
        sys.exit(0)

    raw_email = sys.stdin.buffer.read()
    msg = email.message_from_bytes(raw_email)

    ics_content, part_method = extract_ics(raw_email, msg)
    if not ics_content:
        print("\n[!] No calendar invite (.ics) found in this email.")
        notify("NeoMutt Calendar", "No .ics calendar invite found in this email.")
        sys.exit(1)

    try:
        cal = icalendar.Calendar.from_ical(ics_content)
    except Exception as e:
        print(f"\n[!] Failed to parse calendar invite: {e}")
        sys.exit(1)

    event = None
    for comp in cal.walk('VEVENT'):
        event = comp
        break

    if not event:
        print("\n[!] No event component (VEVENT) found in calendar attachment.")
        sys.exit(1)

    summary = sanitize_header(str(event.get('summary', 'No Title')))
    organizer_raw = str(event.get('organizer', ''))
    organizer = clean_email(organizer_raw)
    organizer_name = ''
    if event.get('organizer') and hasattr(event.get('organizer'), 'params'):
        organizer_name = sanitize_header(str(event.get('organizer').params.get('cn', '')))
    dtstart = event.get('dtstart')
    dtend = event.get('dtend')
    location = sanitize_header(str(event.get('location', '')))
    description = str(event.get('description', '')).strip()
    uid = str(event.get('uid', '')).strip()
    status = str(event.get('status', '')).upper()
    cal_method = str(cal.get('method', '')).upper()
    part_method = str(part_method).upper() if part_method else ""

    user_email = detect_user_email(msg, event)

    # Detect cancellation
    is_cancelled = False
    if "CANCEL" in [cal_method, part_method] or status == "CANCELLED":
        is_cancelled = True
    elif re.search(r'(?i)^(cancelled|canceled):', summary) or re.search(r'(?i)^(cancelled|canceled):', msg.get('Subject', '')):
        is_cancelled = True

    # Check for existing events with this UID
    existing_events = find_events_by_uid(uid)
    is_reschedule = (len(existing_events) > 0) and not is_cancelled

    # TTY handling for interactive prompt overlay
    try:
        if os.environ.get("TEST_TTY_INPUT"):
            import io
            tty_in = io.StringIO(os.environ["TEST_TTY_INPUT"] + "\n\n")
            tty_out = sys.stdout
            is_interactive = False
        else:
            tty_in = open("/dev/tty", "r")
            tty_out = open("/dev/tty", "w")
            is_interactive = tty_out.isatty()
    except Exception:
        tty_in = sys.stdin
        tty_out = sys.stdout
        is_interactive = False

    BOLD = "\033[1m" if is_interactive else ""
    GREEN = "\033[1;32m" if is_interactive else ""
    RED = "\033[1;31m" if is_interactive else ""
    YELLOW = "\033[1;33m" if is_interactive else ""
    CYAN = "\033[1;36m" if is_interactive else ""
    RESET = "\033[0m" if is_interactive else ""

    def tty_print(s=""):
        tty_out.write(s + "\n")
        tty_out.flush()

    # ========================================================
    # FLOW 1: CANCELLATION NOTICE
    # ========================================================
    if is_cancelled:
        tty_print("")
        tty_print(f"{RED}{'=' * 64}{RESET}")
        tty_print(f"  {RED}{BOLD}EVENT CANCELLATION NOTICE: {summary}{RESET}")
        tty_print(f"{RED}{'=' * 64}{RESET}")
        tty_print(f"{BOLD}Organizer : {RESET}{organizer_name + ' <' + organizer + '>' if organizer_name else (organizer or 'Unknown')}")
        tty_print(f"{BOLD}Start     : {RESET}{format_cal_datetime(dtstart)}")
        tty_print(f"{BOLD}End       : {RESET}{format_cal_datetime(dtend)}")
        if location:
            tty_print(f"{BOLD}Location  : {RESET}{location}")
        tty_print(f"{BOLD}Status    : {RESET}{RED}CANCELLED by organizer{RESET}")

        if existing_events:
            tty_print(f"{BOLD}Calendar  : {RESET}{YELLOW}Found in Google Calendar{RESET}")
            tty_print(f"{'-' * 64}")
            tty_print("Action:")
            tty_print(f"  {GREEN}[r] Remove from Google Calendar{RESET} (Recommended)")
            tty_print("  [o] Open Google Calendar in browser")
            tty_print("  [q] Keep event / Quit without changes")
            tty_print(f"{'-' * 64}")

            while True:
                tty_out.write(f"Select [{GREEN}r{RESET}/o/q] (default 'r'): ")
                tty_out.flush()
                ch = get_single_key(tty_in)
                if ch in ['\n', 'r', '']:
                    choice = 'r'
                    break
                elif ch == 'o':
                    query_url = "https://calendar.google.com/calendar/r/search?q=" + urllib.parse.quote(summary)
                    open_url(query_url)
                    tty_print("\n-> Opened Google Calendar search in browser.")
                    continue
                elif ch == 'q':
                    sys.exit(0)
        else:
            tty_print(f"{'-' * 64}")
            tty_print(f"{YELLOW}Note: This cancelled event was not found in your Google Calendar (nothing to delete).{RESET}")
            tty_print("  [o] Search for it on Google Calendar in browser")
            tty_print("  [q] Return to NeoMutt")
            tty_print(f"{'-' * 64}")
            while True:
                tty_out.write("Select [o/q] (default 'q'): ")
                tty_out.flush()
                ch = get_single_key(tty_in)
                if ch == 'o':
                    query_url = "https://calendar.google.com/calendar/r/search?q=" + urllib.parse.quote(summary)
                    open_url(query_url)
                    continue
                else:
                    sys.exit(0)

    # ========================================================
    # FLOW 2: INVITE OR RESCHEDULE / UPDATE
    # ========================================================
    else:
        tty_print("")
        banner_color = CYAN if is_reschedule else BOLD
        tty_print(f"{banner_color}{'=' * 64}{RESET}")
        if is_reschedule:
            tty_print(f"  {CYAN}{BOLD}CALENDAR UPDATE / RESCHEDULE: {summary}{RESET}")
        else:
            tty_print(f"  {BOLD}CALENDAR INVITE: {summary}{RESET}")
        tty_print(f"{banner_color}{'=' * 64}{RESET}")
        tty_print(f"{BOLD}Organizer : {RESET}{organizer_name + ' <' + organizer + '>' if organizer_name else (organizer or 'N/A')}")
        tty_print(f"{BOLD}Start     : {RESET}{format_cal_datetime(dtstart)}")
        tty_print(f"{BOLD}End       : {RESET}{format_cal_datetime(dtend)}")
        if location:
            tty_print(f"{BOLD}Location  : {RESET}{location}")
        if description:
            desc_lines = [l for l in description.splitlines() if l.strip()]
            desc_preview = "\n            ".join(desc_lines[:3])
            if desc_preview:
                tty_print(f"{BOLD}Details   : {RESET}{desc_preview}")

        tty_print(f"{BOLD}Calendar  : {RESET}{GREEN}{CAL_LABEL}{RESET}")
        if is_reschedule:
            tty_print(f"{YELLOW}Notice    : [~] Existing event found! Accepting/importing will update it in place without duplicates.{RESET}")
        tty_print(f"{'-' * 64}")
        tty_print("Choose an action:")
        action_verb = "Update" if is_reschedule else "Add to"
        tty_print(f"  {GREEN}[a] Accept{RESET}           ({action_verb} Google Calendar & send Accept reply)")
        tty_print(f"  {YELLOW}[t] Tentative / Maybe{RESET}({action_verb} Google Calendar & send Tentative reply)")
        tty_print(f"  {RED}[d] Decline{RESET}          (Remove from Google Calendar & send Decline reply)")
        tty_print(f"  [i] Import only      ({action_verb} Google Calendar without sending reply)")
        tty_print("  [o] Open Google Calendar in browser")
        tty_print("  [q] Cancel / Quit")
        tty_print(f"{'-' * 64}")

        while True:
            tty_out.write("Select [a/t/d/i/o/q]: ")
            tty_out.flush()
            ch = get_single_key(tty_in)
            if ch == 'o':
                query_url = "https://calendar.google.com/calendar/r/search?q=" + urllib.parse.quote(summary)
                open_url(query_url)
                tty_print("\n-> Opened Google Calendar search in browser.")
                continue
            elif ch in ['a', 't', 'd', 'i', 'q']:
                choice = ch
                break

    if choice == 'q':
        sys.exit(0)

    # Spawn detached background worker and immediately exit back to NeoMutt!
    with tempfile.NamedTemporaryFile(delete=False, suffix='.eml') as f:
        f.write(raw_email)
        tmp_eml_path = f.name

    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--worker", choice, user_email, tmp_eml_path],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True
    )
    # Return immediately to NeoMutt with 0ms delay
    sys.exit(0)

if __name__ == '__main__':
    main()
