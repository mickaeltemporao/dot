# ====================================================
# NeoMutt Account: Personal (e.g. Gmail / Fastmail / IMAP)
# ====================================================

# Identity
set from = "personal.email@example.com"
set realname = "Your Full Name"
unset signature

# Maildir Mailbox Paths
set folder = "~/Mail/personal"
set spoolfile = "+INBOX"
set postponed = "+[Gmail]/Drafts"
set record = "+[Gmail]/Sent Mail"
set trash = "+[Gmail]/Bin"

# Send via msmtp
set sendmail = "/usr/bin/msmtp -a personal"

# Fast folder jumps (Personal)
macro index,pager ,a "<change-folder>+[Gmail]/All Mail<enter>" "Go to Archive (All Mail)"
macro index,pager ,s "<change-folder>+[Gmail]/Sent Mail<enter>" "Go to Sent Mail"
macro index,pager ,d "<change-folder>+[Gmail]/Drafts<enter>" "Go to Drafts"

# Single-key Account Toggle (Pressing X or ,x while in Personal switches to Work)
macro index,pager X  "<change-folder>~/Mail/work/INBOX<enter>" "Switch to Work Account"
macro index,pager ,x "<change-folder>~/Mail/work/INBOX<enter>" "Switch to Work Account"

