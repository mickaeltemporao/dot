# HTML (Inline: renders clean Markdown with bold/italics via html2markdown.py; falls back to w3m)
text/html; ~/.config/neomutt/html2markdown.py %s %{charset}; test=python3 -c "import html2text" >/dev/null 2>&1; copiousoutput
text/html; w3m -I %{charset} -T text/html -dump -cols 300 %s; copiousoutput

# HTML (Interactive fallback: opens in browser)
text/html; open %s; test=test "$(uname)" = "Darwin"; nametemplate=%s.html
text/html; xdg-open %s; test=test -n "$DISPLAY"; nametemplate=%s.html

# Calendar Invites (.ics)
text/calendar; mutt-ics %s; copiousoutput

# PDF
application/pdf; open %s; test=test "$(uname)" = "Darwin"
application/pdf; zathura %s

# Images
image/*; open %s; test=test "$(uname)" = "Darwin"
image/*; sxiv %s

# MS Office (Word, Excel, PowerPoint)
application/msword; open %s; test=test "$(uname)" = "Darwin"
application/msword; libreoffice %s
application/vnd.openxmlformats-officedocument.wordprocessingml.document; open %s; test=test "$(uname)" = "Darwin"
application/vnd.openxmlformats-officedocument.wordprocessingml.document; libreoffice %s
application/vnd.ms-excel; open %s; test=test "$(uname)" = "Darwin"
application/vnd.ms-excel; libreoffice %s
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet; open %s; test=test "$(uname)" = "Darwin"
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet; libreoffice %s
application/vnd.ms-powerpoint; open %s; test=test "$(uname)" = "Darwin"
application/vnd.ms-powerpoint; libreoffice %s
application/vnd.openxmlformats-officedocument.presentationml.presentation; open %s; test=test "$(uname)" = "Darwin"
application/vnd.openxmlformats-officedocument.presentationml.presentation; libreoffice %s
