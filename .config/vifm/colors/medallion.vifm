" VIFM COLORS
" NY Taxi (Medallion Dark)
" Minimal asphalt black with vibrant taxi yellow accents

highlight clear

highlight Win             cterm=none ctermfg=254        ctermbg=none
highlight Directory       cterm=bold ctermfg=3          ctermbg=none
highlight Link            cterm=none ctermfg=246        ctermbg=none
highlight BrokenLink      cterm=bold ctermfg=1          ctermbg=none
highlight Socket          cterm=none ctermfg=3          ctermbg=none
highlight Device          cterm=none ctermfg=1          ctermbg=none
highlight Fifo            cterm=none ctermfg=3          ctermbg=none
highlight Executable      cterm=none ctermfg=2          ctermbg=none

highlight TopLine         cterm=none ctermfg=244        ctermbg=none
highlight TopLineSel      cterm=bold ctermfg=3          ctermbg=none
highlight StatusLine      cterm=none ctermfg=244        ctermbg=none
highlight Border          cterm=none ctermfg=236        ctermbg=none

highlight Selected        cterm=bold ctermfg=11         ctermbg=236
highlight CurrLine        cterm=bold ctermfg=0          ctermbg=3

highlight WildMenu        cterm=bold ctermfg=0          ctermbg=3
highlight CmdLine         cterm=none ctermfg=254        ctermbg=234
highlight ErrorMsg        cterm=bold ctermfg=1          ctermbg=none
