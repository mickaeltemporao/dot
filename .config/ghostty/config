# Theme
theme = medallion

# Font
font-family = "JetBrains Mono"
font-size = 12.5
font-thicken = true

# Window chrome
window-decoration = false
macos-titlebar-style = hidden

# Fullscreen / maximize
fullscreen = true
macos-non-native-fullscreen = true

# Make it use the whole display area
window-padding-x = 12
window-padding-y = 12

# Cursor
cursor-style = block

# Smoothness
scrollback-limit = 10000

# Hide mouse when typing
mouse-hide-while-typing = true

# Keep accents working
macos-option-as-alt = left
