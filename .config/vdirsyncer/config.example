# vdirsyncer configuration template
# Syncs CardDAV and CalDAV to local directories for khal/khard

[general]
status_path = "~/.local/state/vdirsyncer/status"

# --- WORK CALENDAR (via DavMail) ---
[pair work_calendar]
a = "work_calendar_local"
b = "work_calendar_remote"
collections = ["from a", "from b"]

[storage work_calendar_local]
type = "filesystem"
path = "~/.local/share/calendars/work/"
fileext = ".ics"

[storage work_calendar_remote]
type = "caldav"
url = "http://127.0.0.1:1080/users/your.username/calendar/"
user = "your.username"
password.fetch = ["command", "pass", "email/work"]

# --- WORK CONTACTS (via DavMail) ---
[pair work_contacts]
a = "work_contacts_local"
b = "work_contacts_remote"
collections = ["from a", "from b"]

[storage work_contacts_local]
type = "filesystem"
path = "~/.local/share/contacts/contacts/"
fileext = ".vcf"

[storage work_contacts_remote]
type = "carddav"
url = "http://127.0.0.1:1080/users/your.username@institution.org/contacts/"
user = "your.username"
password.fetch = ["command", "pass", "email/work"]
