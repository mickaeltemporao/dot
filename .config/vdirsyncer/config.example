# vdirsyncer configuration template
# Syncs CardDAV (Exchange contacts) and CalDAV (Google Calendar + Exchange) to local directories for khal/khard

[general]
status_path = "~/.local/share/vdirsyncer/status/"

# ----------------------------------------------------
# WORK CALENDAR (EXCHANGE VIA DAVMAIL CALDAV)
# ----------------------------------------------------
[pair work_calendar]
a = "work_local"
b = "work_remote"
collections = null

[storage work_local]
type = "filesystem"
path = "~/.local/share/calendars/work/"
fileext = ".ics"

[storage work_remote]
type = "caldav"
url = "http://127.0.0.1:1080/users/username/calendar/"
username = "username"
password.fetch = ["command", "pass", "show", "email/work"]

# ----------------------------------------------------
# PERSONAL CALENDAR (GOOGLE CALENDAR VIA OAUTH)
# ----------------------------------------------------
[pair personal_calendar]
a = "personal_local"
b = "personal_remote"
collections = [["personal", "personal", "your.email@gmail.com"]]
metadata = ["color", "displayname"]

[storage personal_local]
type = "filesystem"
path = "~/.local/share/calendars/"
fileext = ".ics"

[storage personal_remote]
type = "google_calendar"
token_file = "~/.local/share/vdirsyncer/google_token"
client_id.fetch = ["command", "pass", "show", "google/vdirsyncer_client_id"]
client_secret.fetch = ["command", "pass", "show", "google/vdirsyncer_client_secret"]
start_date = "datetime.now() - timedelta(days=90)"
end_date = "datetime.now() + timedelta(days=365)"

# ----------------------------------------------------
# UNIFIED CONTACTS (WORK EXCHANGE VIA DAVMAIL CARDDAV)
# ----------------------------------------------------
[pair contacts]
a = "contacts_local"
b = "contacts_remote"
collections = null

[storage contacts_local]
type = "filesystem"
path = "~/.local/share/contacts/contacts/"
fileext = ".vcf"

[storage contacts_remote]
type = "carddav"
url = "http://127.0.0.1:1080/users/your.email@institution.org/contacts/"
username = "username"
password.fetch = ["command", "pass", "show", "email/work"]
