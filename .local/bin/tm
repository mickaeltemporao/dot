#!/usr/bin/env bash
# ~/.local/bin/tm - Minimal tmux session attach & launcher with grouped session support
set -euo pipefail

session="${1:-main}"

init_session() {
    local s="$1"
    tmux new-session -d -s "$s" -n "terminal" -c "$HOME"
    tmux new-window -t "$s:2" -n "neomutt" -c "$HOME"
    tmux send-keys -t "$s:2" "neomutt" C-m
    tmux new-window -t "$s:3" -n "tmp" -c "/tmp"
    tmux select-window -t "$s:1"
}

if [ -n "${TMUX:-}" ]; then
    if ! tmux has-session -t "$session" 2>/dev/null; then
        init_session "$session"
    fi
    exec tmux switch-client -t "$session"
fi

if tmux has-session -t "$session" 2>/dev/null; then
    attached=$(tmux display-message -p -t "$session" '#{session_attached}' 2>/dev/null || echo "0")
    if [ "$attached" -gt 0 ]; then
        exec tmux new-session -t "$session" \; new-window
    else
        exec tmux attach-session -t "$session"
    fi
else
    init_session "$session"
    exec tmux attach-session -t "$session"
fi
