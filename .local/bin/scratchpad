#!/usr/bin/env bash
set -euo pipefail

NOTES_DIR="$HOME/Documents/notes"
mkdir -p "$NOTES_DIR"

title="${*:-}"

# If no title passed from CLI and running in X11, prompt interactively
if [ -z "$title" ] && [ -n "${DISPLAY:-}" ]; then
    choices=$(printf "[Daily Scratchpad]\n[General Scratchpad]\n"; find "$NOTES_DIR" -maxdepth 1 -name "*.md" -printf "%f\n" 2>/dev/null | sort -r | head -n 20)
    title=$(echo "$choices" | fzfmenu --prompt="Note title or select: " || true)
fi

# If user cancelled fzfmenu (empty title)
if [ -z "$title" ]; then
    exit 0
fi

DATE=$(date +%Y-%m-%d)

if [ "$title" = "[Daily Scratchpad]" ]; then
    filename="${DATE}-scratch.md"
    heading="Daily Scratch - ${DATE}"
elif [ "$title" = "[General Scratchpad]" ]; then
    filename="scratchpad.md"
    heading="Scratchpad"
elif [[ "$title" == *.md ]]; then
    filename="$title"
    heading=""
else
    # Clean slugification: transliterate accents, lowercase, replace spaces/symbols with hyphens
    slug=$(echo "$title" | iconv -t ascii//TRANSLIT 2>/dev/null || echo "$title")
    slug=$(echo "$slug" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g' | sed -E 's/^-+|-+$//g')
    [ -z "$slug" ] && slug="quicknote"
    filename="${DATE}-${slug}.md"
    heading="$title"
fi

target="$NOTES_DIR/$filename"

# Add markdown header if new file
if [ ! -s "$target" ] && [ -n "$heading" ]; then
    printf "# %s\n\n*Date: %s*\n\n" "$heading" "$DATE" > "$target"
fi

# Launch in floating st terminal if triggered from dwm/outside terminal
if [ -n "${DISPLAY:-}" ] && [ -z "${IN_SCRATCHPAD:-}" ]; then
    exec st -T scratchpad -g 115x32 -e env IN_SCRATCHPAD=1 nvim "+normal G$" "$target"
else
    exec nvim "+normal G$" "$target"
fi
