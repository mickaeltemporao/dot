#!/usr/bin/env bash
set -euo pipefail

get_selection() {
  (
    IFS=':'
    for p in $PATH; do
      [ -d "$p" ] && find -L "$p" -maxdepth 1 -type f -executable -printf "%f\n" 2>/dev/null
    done
  ) | sort -u | fzfmenu
}

selection=$(get_selection)
if [ -n "$selection" ]; then
  exec "$selection"
fi
