#!/usr/bin/env bash
set -euo pipefail

get_selection() {
  (
    IFS=':'
    for p in $PATH; do
      [ -d "$p" ] || continue
      for f in "$p"/*; do
        [ -f "$f" ] && [ -x "$f" ] && echo "${f##*/}"
      done
    done
  ) | sort -u | fzfmenu
}

selection=$(get_selection)
if [ -n "$selection" ]; then
  exec "$selection"
fi
