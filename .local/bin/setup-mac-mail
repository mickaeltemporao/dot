#!/bin/bash
set -euo pipefail

# setup-mac-mail: Automated installer & service configuration for NeoMutt on macOS.
# Configures the mail toolchain, dependencies, directories, and a 60-second background sync agent.

echo "=========================================================="
echo "    macOS NeoMutt & Mail Environment Automated Setup"
echo "=========================================================="

# 1. Verify Homebrew is installed
if ! command -v brew >/dev/null 2>&1; then
    echo "[!] Homebrew not found. Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [ -d "/opt/homebrew/bin" ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    else
        eval "$(/usr/local/bin/brew shellenv)"
    fi
fi

# 2. Install required CLI utilities via Homebrew
echo "[+] Installing mail packages via Homebrew..."
brew install neomutt isync msmtp khal khard vdirsyncer pass gnupg w3m coreutils

# 3. Install Python dependencies for calendar & smart delivery helpers
echo "[+] Installing Python dependencies..."
python3 -m pip install --quiet --upgrade icalendar python-dateutil || true

# 4. Setup xdg-open shim so attachment openers work natively on macOS
BREW_PREFIX="$(brew --prefix)"
if [ ! -f "$BREW_PREFIX/bin/xdg-open" ]; then
    echo "[+] Creating xdg-open shim for macOS..."
    cat <<'EOF' > "$BREW_PREFIX/bin/xdg-open"
#!/bin/sh
exec /usr/bin/open "$@"
EOF
    chmod +x "$BREW_PREFIX/bin/xdg-open"
fi

# 5. Initialize directories and security permissions
echo "[+] Verifying mail directories and securing permissions..."
mkdir -p "$HOME/Mail/work" "$HOME/Mail/personal"
mkdir -p "$HOME/.cache/neomutt/headers" "$HOME/.cache/neomutt/bodies"
mkdir -p "$HOME/.mail_queue"
mkdir -p "$HOME/.config/msmtp" "$HOME/.config/isync" "$HOME/.config/neomutt/accounts" "$HOME/.config/vdirsyncer"

chmod 700 "$HOME/.config/msmtp" "$HOME/.config/isync" "$HOME/.config/neomutt" "$HOME/.config/vdirsyncer" 2>/dev/null || true
if [ -d "$HOME/.config/passwords" ]; then
    chmod 700 "$HOME/.config/passwords"
fi

# Secure config files if present
for cfg in "$HOME/.config/davmail.properties" "$HOME/.config/isync/mbsyncrc" "$HOME/.config/msmtp/config"; do
    [ -f "$cfg" ] && chmod 600 "$cfg"
done
if [ -d "$HOME/.config/neomutt/accounts" ]; then
    chmod 600 "$HOME/.config/neomutt/accounts"/* 2>/dev/null || true
fi

# Ensure executable bits on helper scripts
chmod +x "$HOME/.config/isync/sync-mail.sh" \
         "$HOME/.config/neomutt/smart_sendmail.py" \
         "$HOME/.config/neomutt/open_browser.py" \
         "$HOME/.config/neomutt/ics-to-khal" 2>/dev/null || true

# 6. Configure launchd User Agent for 60-second background mail sync
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"
PLIST_FILE="$LAUNCH_AGENTS_DIR/org.dotfiles.mbsync.plist"
LOG_DIR="$HOME/.local/state/isync"

mkdir -p "$LAUNCH_AGENTS_DIR" "$LOG_DIR"

echo "[+] Generating launchd service for 60-second mail sync..."
cat <<EOF > "$PLIST_FILE"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.dotfiles.mbsync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$HOME/.config/isync/sync-mail.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$LOG_DIR/mbsync-sync.log</string>
    <key>StandardErrorPath</key>
    <string>$LOG_DIR/mbsync-sync.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>$BREW_PREFIX/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>$HOME</string>
    </dict>
</dict>
</plist>
EOF

# Load and start the launchd job
echo "[+] Activating background sync agent..."
launchctl bootout "gui/$(id -u)/org.dotfiles.mbsync" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$PLIST_FILE"

echo ""
echo "=========================================================="
echo "[✓] macOS NeoMutt installation & 60-second sync activated!"
echo "    - Launchd service: $PLIST_FILE"
echo "    - Sync logs: $LOG_DIR/mbsync-sync.log"
echo "    - Run 'neomutt' or 'nm' to launch your mail client."
echo "=========================================================="
